# PDF Embedding Starter - Environment Variables Configuration

# =============================================================================
# Google Gemini API (for embeddings)
# =============================================================================
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Groq API (for LLM generation)
# =============================================================================
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# Embedding Model Configuration
# =============================================================================
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONALITY=768

# =============================================================================
# Groq Model Configuration
# =============================================================================
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# ChromaDB Local Settings
# =============================================================================
CHROMA_COLLECTION_NAME=pdf_embeddings
CHROMA_PERSIST_DIR=./chroma_db

# =============================================================================
# ChromaDB Cloud Settings
# =============================================================================
# Set to 'true' to use ChromaDB Cloud instead of local storage
USE_CHROMA_CLOUD=false

# ChromaDB Cloud credentials (only required if USE_CHROMA_CLOUD=true)
# Example:
# CHROMA_CLOUD_API_KEY=ck-63USMeUkxtAbK3amn1kNzqMvtz7JSuLhwfkZZmWFrjGU
# CHROMA_CLOUD_TENANT=fb6c2c92-351a-420b-b683-f074cc29abc0
# CHROMA_CLOUD_DATABASE=RAG

CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=

# =============================================================================
# PDF Processing Settings
# =============================================================================
# Chunk size for long PDFs (> 6 pages)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =============================================================================
# Debug Settings (optional)
# =============================================================================
# Set to '1' to enable debug logging for LLM context
DEBUG_LLM=0
